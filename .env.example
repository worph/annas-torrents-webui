# Example environment for Docker Compose / `docker run`
# Copy to `.env` and edit. Never commit real secrets.

# Required for the private control-plane API (paste the same value in Settings).
API_TOKEN=replace-with-a-long-random-value

# Optional public base URL for /view share links (no trailing slash).
# PUBLIC_URL=https://seed.example.com

# libtorrent (default) | qbittorrent
# TORRENT_BACKEND=libtorrent

# Host port for the Web UI (localhost-bound in Compose). Not the BitTorrent port.
# WEB_PORT=8090

# Only with docker-compose.libtorrent.yml — swarm listen port (separate from WEB_PORT).
# TORRENT_PORT=6881

# Skip recursive chown of multi-TB content binds after first successful start.
# CONTENT_CHOWN=0

# Behind a reverse proxy that sets X-Forwarded-For (otherwise leave unset).
# TRUST_PROXY_HEADERS=1

# Development only — never on an exposed host.
# ALLOW_UNAUTHENTICATED_API=1

# qBittorrent backend example:
# TORRENT_BACKEND=qbittorrent
# QBIT_URL=http://host.docker.internal:8080
# QBIT_USER=admin
# QBIT_PASS=change-me
# QBIT_CATEGORY=Anna's Archive Torrents
# QBIT_SAVE_PATH=
